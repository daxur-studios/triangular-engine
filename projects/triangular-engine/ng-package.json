{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/triangular-engine",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    "./assets",
    {
      "glob": "**/*",
      "input": "./schematics",
      "output": "schematics",
      "ignore": ["**/*.spec.cjs"]
    },
    {
      "glob": "**/*",
      "input": "./bin",
      "output": "bin",
      "ignore": ["**/*.spec.mjs"]
    },
    "README.md",
    "CHANGELOG.md",
    {
      "glob": "**/*",
      "input": "./docs",
      "output": "docs"
    },
    {
      "glob": "**/*",
      "input": "./.agents/skills",
      "output": "./skills"
    }
  ]
}
