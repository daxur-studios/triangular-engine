/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // comment this out once not testing demo app
      "triangular-engine": ["projects/triangular-engine/src/public-api"],
      "triangular-engine/postprocessing": [
        "projects/triangular-engine/postprocessing/public-api"
      ],
      "triangular-engine/jolt": ["projects/triangular-engine/jolt/public-api"],
      "triangular-engine/takram": [
        "projects/triangular-engine/takram/public-api"
      ],
      "triangular-engine/terrain": [
        "projects/triangular-engine/terrain/public-api"
      ],
      "triangular-engine/water": [
        "projects/triangular-engine/water/public-api"
      ],
      "triangular-engine/water/postprocessing": [
        "projects/triangular-engine/water/postprocessing/public-api"
      ],
      "triangular-engine/water/jolt": [
        "projects/triangular-engine/water/jolt/public-api"
      ],
      "triangular-engine/scatter": [
        "projects/triangular-engine/scatter/public-api"
      ],
      "triangular-engine/clouds": [
        "projects/triangular-engine/clouds/public-api"
      ],
      "triangular-engine/impostor": [
        "projects/triangular-engine/impostor/public-api"
      ],
      "triangular-engine/trail": [
        "projects/triangular-engine/trail/public-api"
      ],
      "triangular-engine/spline": [
        "projects/triangular-engine/spline/public-api"
      ],
        "triangular-engine/life": ["projects/triangular-engine/life/public-api"],
        "triangular-engine/animals": ["projects/triangular-engine/animals/public-api"],
        "triangular-engine/animals/terrain": ["projects/triangular-engine/animals/terrain/public-api"],
        "triangular-engine/animals/water": ["projects/triangular-engine/animals/water/public-api"],
        "triangular-engine/characters": ["projects/triangular-engine/characters/public-api"],
        "triangular-engine/characters/three": ["projects/triangular-engine/characters/three/public-api"],
        "triangular-engine/navigation": ["projects/triangular-engine/navigation/public-api"],
        "triangular-engine/procedural": ["projects/triangular-engine/procedural/public-api"],
        "triangular-engine/celestial": [
          "projects/triangular-engine/celestial/public-api"
        ],
        "triangular-engine/worldgen": [
          "projects/triangular-engine/worldgen/public-api"
        ],
        "triangular-engine/worldgen/render": [
          "projects/triangular-engine/worldgen/render/public-api"
        ]
    },
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
