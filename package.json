{
  "name": "triangular-workspace",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "test": "ng test",
    "build:triangular-engine": "ng build triangular-engine",
    "test:triangular-engine:navigation": "ng run triangular-engine:test-navigation --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:animals": "ng run triangular-engine:test-animals --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:procedural": "ng run triangular-engine:test-procedural --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:worldgen": "ng run triangular-engine:test-worldgen --watch=false --browsers=ChromeHeadless",
    "navigation:scenarios": "node tools/run-navigation-scenarios.mjs",
    "animals:surface-scenarios": "node tools/run-animal-surface-scenarios.mjs",
    "animals:water-volume-scenarios": "node tools/run-animal-water-volume-scenarios.mjs",
    "animals:population-scenarios": "node tools/run-animal-population-scenarios.mjs",
    "animals:materialization-scenarios": "node tools/run-animal-materialization-scenarios.mjs",
    "animals:movement-scenarios": "node tools/run-animal-movement-scenarios.mjs",
    "animals:air-flock-scenarios": "node tools/run-animal-air-flock-scenarios.mjs",
    "animals:land-herd-scenarios": "node tools/run-animal-land-herd-scenarios.mjs",
    "animals:aquatic-school-scenarios": "node tools/run-animal-aquatic-school-scenarios.mjs",
    "animals:disturbance-scenarios": "node tools/run-animal-disturbance-scenarios.mjs",
    "animals:consequence-scenarios": "node tools/run-animal-consequence-scenarios.mjs",
    "publish": "npm run build:triangular-engine && cd dist/triangular-engine && npm publish",
    "link": "ng build triangular-engine --configuration development && cd dist/triangular-engine && npm link",
    "watch": "ng build triangular-engine --watch --configuration development",
    "dev": "npm run watch",
    "start": "npm run link && npm run watch",
    "local": "npm run link && npm run watch",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.23",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.23",
    "@angular/compiler": "^20.3.23",
    "@angular/core": "^20.3.23",
    "@angular/forms": "^20.3.23",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.23",
    "@angular/platform-browser-dynamic": "^20.3.23",
    "@angular/router": "^20.3.23",
    "@daxur-studios/portal-layout": "file:./daxur-studios-portal-layout-0.0.1.tgz",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.2.1",
    "rxjs": "~7.8.0",
    "three": "0.183.2",
    "three-mesh-bvh": "^0.9.9",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.23",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.23",
    "@dimforge/rapier3d-compat": "^0.18.0",
    "@pmndrs/vanilla": "^1.24.1",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.183.1",
    "jasmine-core": "~5.2.0",
    "jolt-physics": "file:../_external/JoltPhysics.js/jolt-physics-0.38.0.tgz",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.2",
    "postprocessing": "6.39.2",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.1"
  }
}
