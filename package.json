{
  "name": "triangular-workspace",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "check:paths": "node scripts/check-local-paths.mjs --all",
    "docs:records:next": "node scripts/engineering-records.mjs next",
    "docs:records:new": "node scripts/engineering-records.mjs new",
    "docs:records:review": "node scripts/engineering-records.mjs review",
    "docs:records:baseline": "node scripts/engineering-records.mjs baseline",
    "docs:records:check": "node scripts/engineering-records.mjs check",
    "docs:records:manifest": "node scripts/engineering-records.mjs manifest",
    "docs:records:export": "node scripts/export-development-map.mjs",
    "serve:demo-map": "npm run docs:records:export && ng serve demo-app",
    "test:docs:records": "node --test scripts/engineering-records.spec.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:summary": "node projects/triangular-engine/bin/triangular-test-summary.mjs",
    "test:baseline": "node projects/triangular-engine/bin/triangular-test-baseline.mjs",
    "test:receiver": "node projects/triangular-engine/bin/triangular-test-receiver.mjs",
    "test:run": "node projects/triangular-engine/bin/triangular-test-run.mjs",
    "test:triangular-engine:sink": "node --test projects/triangular-engine/bin/triangular-test-sink.spec.mjs projects/triangular-engine/bin/triangular-test-run.spec.mjs",
    "test:triangular-engine:testing": "ng run triangular-engine:test-testing --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test --watch --browsers=Chrome",
    "build:triangular-engine": "ng build triangular-engine",
    "typecheck:schematics": "tsc --allowJs --checkJs --noEmit --strict --skipLibCheck --resolveJsonModule --module commonjs --moduleResolution node --target ES2022 projects/triangular-engine/schematics/shared/index.cjs projects/triangular-engine/schematics/ng-add/index.cjs projects/triangular-engine/schematics/scene-page/index.cjs",
    "test:schematics": "node --test projects/triangular-engine/schematics/ng-add/index.spec.cjs projects/triangular-engine/schematics/scene-page/index.spec.cjs",
    "test:triangular-engine:navigation": "ng run triangular-engine:test-navigation --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:animals": "ng run triangular-engine:test-animals --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:characters": "ng run triangular-engine:test-characters --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:procedural": "ng run triangular-engine:test-procedural --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:planet-material": "ng run triangular-engine:test-planet-material --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:atmosphere": "ng run triangular-engine:test-atmosphere --watch=false --browsers=ChromeHeadless",
    "test:gpu": "ng test triangular-engine --watch=false --karma-config=karma.gpu.conf.cjs --browsers=ChromeHeadlessGpu",
    "test:triangular-engine:cloud-volumes": "ng run triangular-engine:test-cloud-volumes --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:gpu-data-flow": "ng run triangular-engine:test-gpu-data-flow --watch=false --browsers=ChromeHeadless",
    "test:triangular-engine:worldgen": "ng run triangular-engine:test-worldgen --watch=false --browsers=ChromeHeadless",
    "test:scene": "playwright test -c playwright.config.ts",
    "test:cloud-feasibility": "node tools/scene-tests/run-cloud-feasibility.mjs",
    "test:cloud-performance": "node tools/scene-tests/run-cloud-feasibility.mjs --performance",
    "test:cloud-feasibility:status": "node tools/scene-tests/run-cloud-feasibility.mjs --status",
    "test:scene:walkthrough": "playwright test -c playwright.config.ts tests/scene/specs/walkthrough.spec.ts",
    "test:scene:report": "playwright show-report playwright-report",
    "navigation:scenarios": "node tools/run-navigation-scenarios.mjs",
    "animals:surface-scenarios": "node tools/run-animal-surface-scenarios.mjs",
    "animals:water-volume-scenarios": "node tools/run-animal-water-volume-scenarios.mjs",
    "animals:population-scenarios": "node tools/run-animal-population-scenarios.mjs",
    "animals:materialization-scenarios": "node tools/run-animal-materialization-scenarios.mjs",
    "animals:movement-scenarios": "node tools/run-animal-movement-scenarios.mjs",
    "animals:air-flock-scenarios": "node tools/run-animal-air-flock-scenarios.mjs",
    "animals:land-herd-scenarios": "node tools/run-animal-land-herd-scenarios.mjs",
    "animals:aquatic-school-scenarios": "node tools/run-animal-aquatic-school-scenarios.mjs",
    "animals:disturbance-scenarios": "node tools/run-animal-disturbance-scenarios.mjs",
    "animals:consequence-scenarios": "node tools/run-animal-consequence-scenarios.mjs",
    "publish": "npm run build:triangular-engine && cd dist/triangular-engine && npm publish",
    "link": "ng build triangular-engine --configuration development && cd dist/triangular-engine && npm link",
    "watch": "ng build triangular-engine --watch --configuration development",
    "dev": "npm run watch",
    "start": "npm run link && npm run watch",
    "local": "npm run link && npm run watch",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.23",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.23",
    "@angular/compiler": "^20.3.23",
    "@angular/core": "^20.3.23",
    "@angular/forms": "^20.3.23",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.23",
    "@angular/platform-browser-dynamic": "^20.3.23",
    "@angular/router": "^20.3.23",
    "@daxur-studios/portal-layout": "file:ignore/packages/daxur-studios-portal-layout-0.0.1.tgz",
    "@daxur-studios/ui": "file:ignore/packages/daxur-studios-ui-0.0.1-41ceb06e0f3e.tgz",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.2.1",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.23",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.23",
    "@dimforge/rapier3d-compat": "^0.18.0",
    "@playwright/test": "^1.55.0",
    "@pmndrs/vanilla": "^1.24.1",
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "jasmine-core": "~5.2.0",
    "jolt-physics": "1.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "meshoptimizer": "^1.0.1",
    "ng-packagr": "^20.3.2",
    "postprocessing": "6.39.5",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.1"
  }
}
